DATABASE_URL="postgresql://trade:trade@localhost:5432/trade?schema=public"
# Neon: use the pooled URL for DATABASE_URL, and the direct URL here (used only for prisma migrate).
DIRECT_DATABASE_URL=""

# Generate with: npx auth secret
AUTH_SECRET=""

# https://console.cloud.google.com — OAuth 2.0 Client (Web)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# https://discord.com/developers/applications — OAuth2 app
# Redirect URI: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Optional. https://dev.pokemontcg.io — higher rate limits with a key.
POKEMON_TCG_API_KEY=""
