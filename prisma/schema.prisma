generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------- Auth.js models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  handle        String?   @unique
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  listings         Listing[]
  requesterTrades  Trade[]             @relation("RequesterTrades")
  responderTrades  Trade[]             @relation("ResponderTrades")
  tradeComments    TradeComment[]
  lgsMemberships   LgsMembership[]
  gameInterests    UserGameInterest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Domain models ----------

enum GameSlug {
  pokemon
  riftbound
  mtg
  fab
}

enum ListingKind {
  HAVE
  WANT
}

enum OfferType {
  TRADE_ONLY
  CASH_ONLY
  TRADE_OR_CASH
}

enum CardCondition {
  NM // Near Mint
  LP // Lightly Played
  MP // Moderately Played
  HP // Heavily Played
  DMG // Damaged
}

model Game {
  id      String   @id @default(cuid())
  slug    GameSlug @unique
  name    String

  sets      CardSet[]
  cards     Card[]
  interests UserGameInterest[]
}

model UserGameInterest {
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@index([gameId])
}

model CardSet {
  id          String    @id @default(cuid())
  gameId      String
  code        String
  name        String
  releaseDate DateTime?

  game  Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  cards Card[]

  @@unique([gameId, code])
}

model Card {
  id          String   @id @default(cuid())
  gameId      String
  setId       String
  externalId  String // upstream ID from pokemontcg.io or riftbound-db
  name        String
  number      String?
  rarity      String?
  imageUrl    String?
  orientation String? // "portrait" or "landscape" — controls tile aspect ratio
  cardType    String? // Unit / Spell / Battlefield / Gear / Legend / ...
  domains     String[] @default([])
  regions     String[] @default([])

  game       Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  set        CardSet     @relation(fields: [setId], references: [id], onDelete: Cascade)
  listings   Listing[]
  tradeItems TradeItem[]

  @@unique([gameId, externalId])
  @@index([gameId, name])
  @@index([setId])
  @@index([gameId, rarity])
  @@index([gameId, cardType])
}

model Listing {
  id         String         @id @default(cuid())
  userId     String
  cardId     String
  kind       ListingKind
  offerType  OfferType      @default(TRADE_ONLY)
  priceCents Int?
  condition  CardCondition?
  quantity   Int            @default(1)
  note       String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, kind])
  @@index([cardId, kind])
  @@index([userId, kind])
}

// ---------- Trade lifecycle ----------

enum TradeStatus {
  OPEN
  REQUESTED
  ACCEPTED
  FINISHED
}

enum TradeDirection {
  FROM_REQUESTER
  FROM_RESPONDER
}

model Trade {
  id                    String      @id @default(cuid())
  requesterId           String
  responderId           String
  status                TradeStatus @default(OPEN)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  finishedAt            DateTime?
  requesterFinishedAt   DateTime?
  responderFinishedAt   DateTime?
  cashCents             Int?      // + = responder pays requester; - = requester pays responder
  lastProposedById      String?   // whoever sent or countered most recently

  requester User           @relation("RequesterTrades", fields: [requesterId], references: [id], onDelete: Cascade)
  responder User           @relation("ResponderTrades", fields: [responderId], references: [id], onDelete: Cascade)
  items     TradeItem[]
  comments  TradeComment[]

  @@index([requesterId, status])
  @@index([responderId, status])
}

model TradeComment {
  id        String   @id @default(cuid())
  tradeId   String
  userId    String
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tradeId, createdAt])
}

// ---------- LGS (Local Game Store) ----------

enum LgsRole {
  OWNER
  MEMBER
}

model Lgs {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  city      String?
  createdAt DateTime @default(now())

  memberships LgsMembership[]
}

model LgsMembership {
  id        String   @id @default(cuid())
  userId    String
  lgsId     String
  role      LgsRole  @default(MEMBER)
  isPrimary Boolean  @default(false)
  joinedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lgs  Lgs  @relation(fields: [lgsId], references: [id], onDelete: Cascade)

  @@unique([userId, lgsId])
  @@index([lgsId])
  @@index([userId, isPrimary])
}

model TradeItem {
  id        String         @id @default(cuid())
  tradeId   String
  cardId    String
  direction TradeDirection
  quantity  Int            @default(1)

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([tradeId, cardId, direction])
  @@index([tradeId])
}
